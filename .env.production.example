# Sample production .env for docker/compose.prod.yml.
# Copy to .env on the server (gitignored). Replace placeholders.
# Generate SESSION_SECRET: openssl rand -hex 32

APP_ENV=production
APP_DEBUG=false

# compose.prod.yml overrides these inside the api container to /data
# and /data/sessions, and bind-mounts host ./data at /data.
DATA_PATH=./data

# Host port for nginx (SPA + /api on one origin). Default 80.
# WEB_PORT=80

# Google OAuth 2 (authorization code). Use a Web client for this origin.
# Authorized JavaScript origins: https://app.example.com
# Authorized redirect URI: https://app.example.com/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://app.example.com/api/auth/google/callback

# HMAC key for the HttpOnly session cookie. Required. ≥16 characters.
SESSION_SECRET=replace-with-openssl-rand-hex-32

# Cookie Secure flag. Unset: true when APP_ENV=production (correct behind TLS).
# Set false only if you terminate HTTP with no TLS (not recommended).
# SESSION_SECURE=false

# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW=60
