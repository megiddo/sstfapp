# Copy to .env (gitignored). Docker Compose loads this file.

APP_ENV=development
APP_DEBUG=true

# Host path for local PHP; Compose overrides to /data inside the api container.
DATA_PATH=./data

# Google Identity Services client ID (OAuth 2 / GIS). Never commit a real production secret.
GOOGLE_CLIENT_ID=
PUBLIC_GOOGLE_CLIENT_ID=

# HMAC key for the HttpOnly session cookie. Use a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Auth route rate limit (per IP). Testing defaults to a high max so unit tests do not flake.
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW=60
